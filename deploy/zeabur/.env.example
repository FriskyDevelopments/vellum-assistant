# Copy to .env in this directory, then run ./gen-secrets.sh (fills the three tokens).
# Provider keys: set at least one LLM key. Do not commit .env.

VELLUM_ASSISTANT_NAME=vellum
GATEWAY_PORT=7830
ASSISTANT_PORT=7821
GATEWAY_TRUST_PROXY=true

# Required: 32-byte hex (or any high-entropy string). Generated by gen-secrets.sh.
CES_SERVICE_TOKEN=
ACTOR_TOKEN_SIGNING_KEY=
GUARDIAN_BOOTSTRAP_SECRET=

# Optional image overrides (published tags or local builds).
# VELLUM_ASSISTANT_IMAGE=
# VELLUM_GATEWAY_IMAGE=
# VELLUM_CREDENTIAL_EXECUTOR_IMAGE=

# LLM (set one or more).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional extra providers forwarded into the assistant container.
# FIREWORKS_API_KEY=
# OPENROUTER_API_KEY=
# AI_GATEWAY_API_KEY=
# MINIMAX_API_KEY=
# ATLASCLOUD_API_KEY=
# TOGETHER_API_KEY=
# LITELLM_API_KEY=
# OPENCODE_API_KEY=
# BASETEN_API_KEY=
# POOLSIDE_API_KEY=
# TYPESAFE_API_KEY=

# Optional search providers.
# PERPLEXITY_API_KEY=
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# FIRECRAWL_API_KEY=
# EXA_API_KEY=

# Channel tokens (gateway). Names vary by channel; set only what you use.
# TELEGRAM_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
